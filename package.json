    "@angular/router": "^21.2.0",
    "@ngrx/signals": "^21.1.0",
    "@taiga-ui/core": "^5.6.0",
    "@taiga-ui/icons": "^5.6.0",
    "@taiga-ui/kit": "^5.6.0",
    "@taiga-ui/layout": "^5.6.0",
    "@tinkoff/ng-dompurify": "^4.0.0",
